<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="250dp">

            <ImageView
                android:id="@+id/iv_detail_gambar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_background"/>

            <ImageView
                android:id="@+id/iv_detail_back"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="30dp"
                android:padding="1dp"
                android:background="@drawable/bg_back_round"
                android:src="@drawable/btn_back"
                android:foreground="?selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:layout_gravity="start|top"/>

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/bg_main_content"
            android:layout_marginTop="-20dp"> <TextView
            android:id="@+id/tv_detail_judul"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Judul Berita Besar"
            android:gravity="center"
            android:textColor="@color/login_text_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_detail_tanggal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Senin, 20 November 2025"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_detail_kategori"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="Kategori"
                    android:textColor="@color/home_tag_red"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_detail_isi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Isi deskripsi berita panjang..."
                android:justificationMode="inter_word"
                android:textColor="@color/login_text_title"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>